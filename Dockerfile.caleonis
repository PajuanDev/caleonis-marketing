# Complete upstream interface; runtime operations use the existing Caléonis API.
FROM node:22.20-bookworm-slim AS studio-assets
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /studio-build
COPY var/caleonis/upstream-studio/embedded /studio-build/embedded
RUN git init /studio-upstream \
    && git -C /studio-upstream remote add origin https://github.com/TechBeme/open-higgsfield.git \
    && git -C /studio-upstream fetch --depth 1 origin 1df1148e46d1b47d29e117b7bb1971a65c4286ee \
    && git -C /studio-upstream checkout --detach FETCH_HEAD \
    && test "$(git -C /studio-upstream rev-parse HEAD)" = 1df1148e46d1b47d29e117b7bb1971a65c4286ee
RUN cd /studio-upstream && npm ci --ignore-scripts --no-audit --no-fund
RUN npm install --prefix /studio-build/embedded --ignore-scripts --no-audit --no-fund \
    && node /studio-build/embedded/build.mjs /studio-upstream /studio-assets

FROM node:22.20-bookworm-slim
ARG NEXT_PUBLIC_VERSION=caleonis-bootstrap
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make python3-pip bash nginx util-linux ca-certificates \
    libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*
RUN addgroup --system www \
    && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
    && mkdir -p /www /uploads \
    && chown -R www:www /www /var/lib/nginx
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2@6
WORKDIR /app
COPY . /app
COPY --from=studio-assets /studio-assets /app/apps/frontend/public/caleonis-studio
COPY var/caleonis/nginx.conf /etc/nginx/nginx.conf
RUN node --test var/caleonis/brand-routes.test.mjs \
    && node var/caleonis/brand-routes.mjs \
    && bash -n var/caleonis/start.sh \
    && node --check var/caleonis/health.cjs \
    && nginx -t
# Both production and build dependencies are required by this monorepo.
RUN NODE_ENV=development pnpm install --frozen-lockfile
RUN node --experimental-strip-types --test var/caleonis/cookie-domain.test.mjs var/caleonis/higgsfield.test.mjs \
    && NODE_OPTIONS="--max-old-space-size=4096" pnpm run build
ENV NODE_ENV=production IS_GENERAL=true STORAGE_PROVIDER=local \
    UPLOAD_DIRECTORY=/uploads NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads \
    BACKEND_INTERNAL_URL=http://127.0.0.1:3000 DISABLE_REGISTRATION=true
EXPOSE 5000
CMD ["bash", "/app/var/caleonis/start.sh"]
